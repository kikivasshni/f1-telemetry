{
  "name": "pit-wall",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Pit Wall: race replay, telemetry and race intelligence built on open F1 timing data.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "ingest": "node pipeline/run.mjs",
    "history": "node pipeline/history.mjs",
    "predict": "node pipeline/predict.mjs"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.2.5",
    "@fontsource-variable/jetbrains-mono": "^5.2.5",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.176.0",
    "zustand": "^5.0.4"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@types/three": "^0.176.0",
    "@vitejs/plugin-react": "^4.4.1",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
